# NammaSpot Environment Variables
# Copy this file to .env.local and fill in your values
# CRITICAL: Never commit real values to .env or .env.local — use Vercel Environment Variables instead

# ============================================================================
# SUPABASE (Database & Auth) - Required for seller accounts & reviews
# ============================================================================
# Get these from Supabase dashboard: Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# GOOGLE SHEETS & APPS SCRIPT (Sellers, Products, Reviews Data)
# ============================================================================
# Set SHEETS_API_BASE to your Apps Script Web App deployment URL
# If not provided, falls back to localhost (dev only)
# SHEETS_API_BASE=https://script.google.com/macros/d/{SCRIPT_ID}/useweb?v={VERSION}

# Write token for Apps Script doPost — only set when doPost is implemented in backend/Code.gs
# SHEETS_WRITE_TOKEN=your_secure_write_token_here

# ============================================================================
# ADMIN AUTHENTICATION
# ============================================================================
# Secure admin password for accessing /admin console
# Used for seller approvals, status management, review moderation
ADMIN_PASSWORD=your_secure_admin_password

# ============================================================================
# BUILD & DEPLOYMENT NOTES
# ============================================================================
# Client-side vars (VITE_*) are injected at build time and visible in the browser
# Server-side vars (without VITE_ prefix) are only available on the server
# This protects secrets like SUPABASE_SERVICE_ROLE_KEY and ADMIN_PASSWORD
#
# For Vercel deployment:
# 1. Go to Vercel Project Settings → Environment Variables
# 2. Add each variable above for "Production"
# 3. Run `npm run build` locally to verify
# 4. Commit code and push to trigger deployment
